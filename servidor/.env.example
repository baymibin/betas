# Surf Salvaje · variables de entorno del servidor.
# Copia este archivo a servidor/.env y rellénalo. servidor/.env NO se sube a git.
# Guía paso a paso: docs/AVANCES_SURF_SALVAJE.md (secciones "Login Google" y "Login Discord").

# URL pública con la que los jugadores abren el juego (sin barra final).
# Las URLs de callback se forman a partir de aquí:
#   {PUBLIC_URL}/auth/google/callback
#   {PUBLIC_URL}/auth/discord/callback
PUBLIC_URL=http://localhost:3000
PORT=3000

# Clave para firmar sesiones y flujos OAuth (32+ caracteres aleatorios).
# En local, si falta, el servidor genera una en servidor/data/.session-secret.
# En producción (NODE_ENV=production) es obligatoria.
SESSION_SECRET=

# Base de datos. Elige UNA de las dos líneas:
#  · MySQL / MariaDB (p. ej. la de aaPanel > Databases). Las tablas se crean solas al arrancar;
#    no hay que importar ningún .sql. Si la contraseña tiene símbolos (@ : / # ?), escríbelos
#    codificados: @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F.
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/surf_salvaje
#  · SQLite (un archivo, sin servidor de base de datos). Es la opción por defecto.
DATABASE_URL=file:./data/surf-salvaje.db
# Conexiones simultáneas a MySQL (opcional, por defecto 10).
# DATABASE_POOL=10

# Google Identity (OpenID Connect) · Google Cloud Console > APIs y servicios > Credenciales
# Tipo: "ID de cliente de OAuth" · Aplicación web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth2 · https://discord.com/developers/applications > tu app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Invitación a tu servidor de Discord (icono de abajo a la derecha del menú). Solo https.
# Ej.: https://discord.gg/tu-invitacion
DISCORD_INVITE_URL=

# NODE_ENV=production
